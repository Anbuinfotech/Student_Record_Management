# Copy this to .env for local dev, and set VITE_API_URL as an
# Environment Variable in Vercel project settings for production.
VITE_API_URL=http://localhost:8080/api

# Optional: enables real authentication when a Spring Security login endpoint
# is available. It should return { token, user: { name, role } } from POST /auth/login.
# VITE_AUTH_API_URL=http://localhost:8080/api
